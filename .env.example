# AgentAlgo deployment configuration (docker compose reads this as .env)

# REQUIRED in production — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTALGO_SECRET_KEY=

# REQUIRED in production — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored user API key unrecoverable.
AGENTALGO_FERNET_KEY=

# Comma-separated allowed origins for the browser app
AGENTALGO_CORS_ORIGINS=http://localhost:8080

# Demo mode: simulated runs without LLM keys (true/false)
AGENTALGO_DEMO_MODE=true

# REQUIRED: super-admin bootstrap (created/promoted at startup).
# The compose file refuses to start without these. Never use a guessable password.
AGENTALGO_ADMIN_EMAIL=
AGENTALGO_ADMIN_PASSWORD=

# SSRF guard: false blocks user-supplied endpoints (Ollama/vLLM URLs) from
# resolving to private/internal addresses. Set true ONLY for personal desktop
# use where your Ollama runs on localhost. Note: DNS-rebinding after validation
# remains a residual risk — see QUALITY_REPORT.md.
AGENTALGO_ALLOW_PRIVATE_URLS=false

# Optional overrides
# AGENTALGO_DATABASE_URL=postgresql+psycopg://user:pass@host/agentalgo
# AGENTALGO_TOKEN_MINUTES=1440
# AGENTALGO_MAX_CONCURRENT_RUNS=3
